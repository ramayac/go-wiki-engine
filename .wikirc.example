# wiki-engine configuration — copy to .wikirc and edit
# See: wiki/prologue/config.md for full documentation

# --- Paths ---

# Single safe directory segment for the wiki (relative to repo root).
wiki_dir = "wiki"

# Default git diff range used by changed, candidates, refresh, watch, and stale-content.
# If set to "main...HEAD" and no `main` branch exists, the engine auto-detects
# the base branch (origin/main, main, origin/master, master).
default_diff = "main...HEAD"

# Optional fallback base ref for branch-aware check, changed, and candidates.
# base_ref = "main"

# Optional Go regex used to validate `issue` references in frontmatter.
# issue_pattern = "^[A-Z][A-Z0-9]*-[0-9]+$"

# Schema version identifier.
# schema_version = "2"

# Number of log entries shown by log-tail.
log_lines = 10

# --- Detection thresholds ---

# Jaccard similarity threshold for duplicate page detection.
# Pages above this threshold are flagged as potential duplicates.
# Range: 0.0-1.0. Set to 0 to disable.
duplicate_threshold = 0.7

# Days since a page's last git commit before it is flagged as stale.
# Falls back to file mtime outside a git repository; skipped with an info
# notice in shallow clones. When the repo has active source changes, severity
# upgrades from info to warn. Set to 0 to disable.
stale_days = 30

# --- Context loading ---

# Default wiki-engine context to --summarize mode.
context_summarize = false

# Bounds for wiki-engine context catalog output (0 disables a bound).
context_max_pages = 100
context_max_bytes = 65536

# --- Watch mode ---

# Polling interval in seconds for wiki-engine watch.
# When > 0, watch runs changed + candidates + lint on every tick.
# Set to 0 to disable continuous watch (wiki-engine watch --once still works).
watch_interval = 0

# --- Lint severity gate ---

# Minimum severity that causes wiki-engine lint to fail with exit code 1.
# Issues below this level are still printed but do not fail the run.
# Values: error | warn | info. Also drives the watch --once exit code.
fail_severity = "warn"

# --- Ignored paths ---

# Paths excluded from candidate filtering (wiki-engine candidates).
# - Trailing "/": matches a root directory and everything beneath it ("wiki/").
# - No "/": matches any path segment at any depth ("*.log", "vendor").
# - Contains "/": matches the full path from the root ("docs/*.md", "**/gen/").
ignore = [
  "wiki/",
  "bin/",
  "vendor/",
  "*.log",
  "*.tmp",
]
